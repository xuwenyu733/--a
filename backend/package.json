{
  "name": "campus-secondhand-backend",
  "version": "1.0.0",
  "description": "校园二手交易平台后端",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/app.js",
    "dev:lan": "HOST=0.0.0.0 node --watch src/app.js",
    "start": "NODE_ENV=production node src/app.js",
    "start:prod": "NODE_ENV=production node src/app.js",
    "restart:prod": "bash ../scripts/restart-server.sh",
    "seed": "node src/utils/seed.js",
    "seed:demo": "node src/utils/seedDemo.js",
    "seed:all": "node src/utils/seed.js && node src/utils/seedDemo.js",
    "smoke": "node ../scripts/smoke-api.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/**/*.integration.test.js'",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "typecheck": "tsc --noEmit",
    "typecheck:helpers": "tsc --noEmit -p tsconfig.helpers.json",
    "backfill:thumbs": "node scripts/backfill-thumbnails.mjs",
    "migrate:delivery-deadlines": "node scripts/migrate-delivery-deadlines.mjs",
    "fix:user-indexes": "node scripts/fix-user-sparse-indexes.mjs",
    "backfill:delivery-completed-at": "node scripts/backfill-delivery-completed-at.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop campus-secondhand",
    "pm2:restart": "pm2 restart campus-secondhand",
    "pm2:logs": "pm2 logs campus-secondhand"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.9",
    "openai": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pinyin-pro": "^3.28.1",
    "puppeteer-core": "^25.0.4",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "webpack-bundle-analyzer": "^5.3.0"
  }
}
