# 开发: development | 生产: production
NODE_ENV=development
PORT=3001
# 开发局域网: 0.0.0.0 | 生产建议: 127.0.0.1（仅 Nginx 反代）
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/campus_secondhand
# 生产示例（必须带账号密码）:
# MONGODB_URI=mongodb://campus_user:强密码@127.0.0.1:27017/campus_secondhand?authSource=admin
JWT_SECRET=campus-secondhand-jwt-secret-change-in-production
JWT_REFRESH_SECRET=campus-secondhand-refresh-secret-change-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
# refreshToken 通过 httpOnly Cookie（path=/api）下发，生产需配置 CORS_ORIGINS 且前端请求 withCredentials
SUPER_ADMIN_PHONE=13800000000
SUPER_ADMIN_PASSWORD=admin123456
DEV_SMS_CODE=123456
# 生产环境须配置真实短信服务（SMS_HOST 等），且勿使用 123456

# ---------- 安全（必读）----------
# 1. 切勿将 backend/.env 提交 Git；若曾提交请立即轮换 OPENAI/JWT 等密钥
# 2. 生产必须设置 CORS_ORIGINS、强 JWT_SECRET、强 SUPER_ADMIN_PASSWORD
# 3. refreshToken 通过 httpOnly Cookie（path=/api）下发

# 生产环境 CORS 白名单（逗号分隔，勿用 *）
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 简历模块开关（false 时 /api/resume 返回 404）
# RESUME_MODULE_ENABLED=true

# MongoDB 连接池（可选，默认 max=15 min=3）
# MONGODB_MAX_POOL_SIZE=15
# MONGODB_MIN_POOL_SIZE=3

# 日志级别: error | warn | info | debug
# LOG_LEVEL=info

# API 对外根地址（可选）。未配置时按请求 Host 拼接 /uploads 完整 URL，供小程序/跨域客户端使用
# PUBLIC_BASE_URL=http://192.168.1.100:3001

# ---------- 缓存（可选）----------
# 未配置时使用进程内内存缓存；配置后平台配置/推荐结果走 Redis
# REDIS_URL=redis://127.0.0.1:6379
# PLATFORM_CONFIG_CACHE_TTL=60
# RECOMMEND_CACHE_TTL=120
# WS_REDIS_CHANNEL=campus:ws:push

# ---------- AI 简历优化（整合模块，可选）----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 图片存储：不配置下方 OSS 项 = 本地 backend/uploads（未购 OSS 时保持注释即可）
# ---------- 可选：离线邮件通知（SMTP）----------
# 配置后，用户不在线且已填写通知邮箱时会收到邮件提醒
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@email.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=校园二手 <noreply@example.com>

# ---------- 微信小程序登录 ----------
# 未配置 WECHAT_MINI_APP_SECRET 时，开发环境用 code 生成沙箱 openid（勿用于生产）
# WECHAT_MINI_APP_ID=
# WECHAT_MINI_APP_SECRET=

# ---------- 在线支付 ----------
# PAYMENT_ENABLED=true          # false 关闭在线支付（仅保留扫码转账）
# PAYMENT_MODE=sandbox          # sandbox=开发模拟 | live=正式商户（需下方密钥）
# PAYMENT_EXPIRE_MINUTES=30
# PAYMENT_NOTIFY_BASE_URL=http://localhost:3001
# 面交仍支持：卖家上传收款码 + 买家标记付款 + 卖家确认收款
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# ---------- 可选：阿里云 OSS ----------
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=your-key-id
# OSS_ACCESS_KEY_SECRET=your-key-secret
# OSS_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# 详见项目根目录 OSS_SETUP.md
